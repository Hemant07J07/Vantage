# Read automatically by `docker compose` for ${VAR} interpolation in
# docker-compose.yml. Only the `postgres` service's own credentials live here —
# every other service reads its own backend/.env, ai-service/.env or
# frontend/.env.local via an `env_file:` directive.
#
# These must stay in sync with POSTGRES_* in backend/.env, which is what Django
# and the Celery workers actually connect with.
#
# Fine as-is for local Docker development (Postgres is not published outside the
# compose network). Change all three before any real deployment — see SECURITY.md.
POSTGRES_DB=vantage
POSTGRES_USER=vantage
POSTGRES_PASSWORD=vantage
