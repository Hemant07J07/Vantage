# Groq's OpenAI-compatible endpoint runs the actual model — no local daemon
# to point at. Get a free key at https://console.groq.com (no card required).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional. Powers the real web_search tool via Ollama's hosted search API
# (https://ollama.com/api/web_search) instead of the no-key DuckDuckGo
# fallback. Get a free key at https://ollama.com/settings/keys — leave
# blank to skip straight to the DuckDuckGo fallback. Unrelated to GROQ_*
# above — this is only a web-search provider, not the model.
OLLAMA_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://backend:8000
