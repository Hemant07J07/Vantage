DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=vantage
POSTGRES_USER=vantage
POSTGRES_PASSWORD=vantage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

AI_SERVICE_URL=http://ai-service:8001
# Per-call HTTP budget for the AI service. Must stay under CELERY_TASK_SOFT_TIME_LIMIT.
AI_SERVICE_TIMEOUT_SECONDS=100
# Research steps do more work per call (search + synthesis) so they get longer.
AI_RESEARCH_TIMEOUT_SECONDS=150
HIGH_INTENT_THRESHOLD=75
# How long a company's research stays fresh before a repeat request re-runs it.
RESEARCH_CACHE_TTL_HOURS=168

# --- Change monitoring ------------------------------------------------------
# Off by default: when true, a scheduler re-checks each researched company on a
# timer, fetching their public pages. Only a change that looks material spends
# a full research run.
MONITOR_ENABLED=false
MONITOR_BASE_INTERVAL_HOURS=24
MONITOR_MAX_INTERVAL_HOURS=168
MONITOR_MAX_BATCH=25
MONITOR_TIMEOUT_SECONDS=120

# --- Trend scanning ----------------------------------------------------------
# Off by default: when true, a scheduler periodically searches the open web
# (funding/hiring/news) for each researched company. A high-strength new
# signal triggers a full research run; anything else just joins the signal
# feed. Distinct from change monitoring above — that hashes a company's own
# pages; this actually searches for news about it.
TREND_SCAN_ENABLED=false
TREND_SCAN_INTERVAL_HOURS=24
TREND_SCAN_DISPATCH_MINUTES=60
TREND_SCAN_MAX_BATCH=5
TREND_SCAN_SIGNAL_DEDUPE_DAYS=45
