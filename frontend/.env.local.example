# Used server-side only (Server Components, Route Handlers) — never sent to the browser.
BACKEND_INTERNAL_URL=http://backend:8000

# Read by the browser, so it must carry the NEXT_PUBLIC_ prefix. In Docker this
# is baked in at image build time via the build ARG in docker-compose.yml; this
# value only takes effect for `npm run dev`.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/dashboard/
