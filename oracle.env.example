# Env for the Celery layer running on the Oracle Cloud VM — see
# docker-compose.oracle.yml. Same variables backend/.env defines, except
# POSTGRES_HOST/REDIS_URL/AI_SERVICE_URL now point at Render's *external*
# connection strings instead of docker-network hostnames, since nothing else
# in this compose file runs on the same network as Render's services.
#
# Before this connects to anything:
#   1. On Render, open vantage-db's Info page -> Access Control -> enable
#      external connections -> add this VM's public IP.
#   2. Same on vantage-redis's Info page.
#   3. Copy each service's EXTERNAL host/port/user/password (not the internal
#      ones docker-compose.yml's backend service uses) from Render's dashboard
#      into the values below.

# Must be the SAME value the Render backend service uses — Django's JWT
# signing key is shared state, not per-instance config.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=vantage
POSTGRES_USER=vantage
POSTGRES_PASSWORD=
# Render's Postgres EXTERNAL hostname, e.g. dpg-xxxxx-a.oregon-postgres.render.com
POSTGRES_HOST=
POSTGRES_PORT=5432

# Render Key Value's EXTERNAL connection string. rediss:// (TLS), not
# redis:// — this traffic now crosses the open internet.
REDIS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# The Render ai-service's public HTTPS URL, e.g.
# https://vantage-ai-service.onrender.com — no docker-network shortcut
# available from this VM.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_SECONDS=100
AI_RESEARCH_TIMEOUT_SECONDS=200
HIGH_INTENT_THRESHOLD=75
RESEARCH_CACHE_TTL_HOURS=168

# --- Change monitoring ------------------------------------------------------
MONITOR_ENABLED=true
MONITOR_BASE_INTERVAL_HOURS=24
MONITOR_MAX_INTERVAL_HOURS=168
MONITOR_MAX_BATCH=25
MONITOR_TIMEOUT_SECONDS=120

# --- Trend scanning ----------------------------------------------------------
TREND_SCAN_ENABLED=true
TREND_SCAN_INTERVAL_HOURS=24
TREND_SCAN_DISPATCH_MINUTES=60
TREND_SCAN_MAX_BATCH=5
TREND_SCAN_SIGNAL_DEDUPE_DAYS=45
