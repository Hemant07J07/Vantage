# Env for the Celery layer, hosted on Railway — five separate services there
# (qualify-worker, research-worker, monitor-worker, trends-worker, beat), each
# needing this same set of variables. Railway doesn't read a file like this
# automatically the way docker-compose's env_file does; paste these into each
# service's Variables tab in the Railway dashboard (or `railway variables set`
# via the CLI), one service at a time.
#
# Same variables backend/.env defines: Postgres lives on Supabase, the broker
# lives on Upstash — neither is Railway-hosted, so these workers connect out
# to both over the open internet, same as the Render-hosted backend does.
#
# Before this connects to anything:
#   1. From your Supabase project's Database settings, copy the POOLER
#      connection info (host/port/user/password) — the same values
#      backend/.env uses locally, not the direct connection.
#   2. From your Upstash Redis database's dashboard, copy its rediss://
#      connection string.
#   3. Copy vantage-ai-service's public URL from its Render dashboard page.

# Must be the SAME value the Render backend service uses — Django's JWT
# signing key is shared state, not per-instance config.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=postgres
# Supabase's pooler username is project-specific: postgres.<project-ref>
POSTGRES_USER=
POSTGRES_PASSWORD=
# Supabase's pooler host, e.g. aws-0-ap-south-1.pooler.supabase.com
POSTGRES_HOST=
POSTGRES_PORT=5432

# Upstash's rediss:// connection string (TLS required — Celery won't start
# against it without CELERY_BROKER_USE_SSL, which backend/config/settings.py
# already sets automatically whenever this starts with rediss://).
REDIS_URL=

# The Render ai-service's public HTTPS URL, e.g.
# https://vantage-ai-service.onrender.com
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_SECONDS=100
AI_RESEARCH_TIMEOUT_SECONDS=200
HIGH_INTENT_THRESHOLD=75
RESEARCH_CACHE_TTL_HOURS=168

# --- Change monitoring ------------------------------------------------------
MONITOR_ENABLED=true
MONITOR_BASE_INTERVAL_HOURS=24
MONITOR_MAX_INTERVAL_HOURS=168
MONITOR_MAX_BATCH=25
MONITOR_TIMEOUT_SECONDS=120

# --- Trend scanning ----------------------------------------------------------
TREND_SCAN_ENABLED=true
TREND_SCAN_INTERVAL_HOURS=24
TREND_SCAN_DISPATCH_MINUTES=60
TREND_SCAN_MAX_BATCH=5
TREND_SCAN_SIGNAL_DEDUPE_DAYS=45
